# Unity standard gitignore
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Asset meta files must tracked, but ignore OS metadata
.DS_Store
Thumbs.db
desktop.ini

# Autogenerated IDE files
.vs/
.idea/
.vscode/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity crash reports & logs
sysinfo.txt
*.stackdump
CrashReport*

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Scratch directory
.scratch/
