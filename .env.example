# MonsterLink Web Deployment & Supabase Environment Configuration

# Next.js Public Supabase Credentials (Anon Key is safe for client-side use with RLS)
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Disable real NFC simulator overlay in production
NEXT_PUBLIC_ENABLE_SIMULATOR=true
